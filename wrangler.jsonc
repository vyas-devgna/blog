{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blog",
  "account_id": "5e10e941c40c5e6e8d9f3805660cbe15",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "blog.vyasdevgna.online", "custom_domain": true }],
  "vars": {
    "PUBLIC_SITE_URL": "https://blog.vyasdevgna.online",
    "NEON_AUTH_BASE_URL": "https://ep-rough-fire-b3g7govq.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth",
  },
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "observability": { "enabled": true },
}
