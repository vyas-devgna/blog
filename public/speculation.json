{
  "prerender": [
    {
      "where": {
        "and": [
          { "href_matches": "/blog/*" },
          { "not": { "selector_matches": "[rel~=nofollow]" } }
        ]
      },
      "eagerness": "moderate"
    }
  ],
  "prefetch": [
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          {
            "not": {
              "href_matches": [
                "/api/*",
                "/auth/*",
                "/login/*",
                "/signup/*",
                "/settings/*",
                "/admin/*",
                "/moderation/*",
                "/notifications/*",
                "/verify-email/*",
                "/forgot-password/*",
                "/u/*"
              ]
            }
          },
          { "not": { "selector_matches": "[rel~=nofollow]" } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
