---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPublishedPosts, getReadingTime } from '../../lib/posts';
export const prerender = true;
const posts = await getPublishedPosts();
---

<SiteLayout title="Search" description="Search articles on this site.">
	<section class="page-shell search-page">
		<PageHeader label="The archive" title="Search" intro="Look for an idea, a subject, or a phrase across the writing." />
		<div class="search-control">
			<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
				<circle cx="10.8" cy="10.8" r="6.5" />
				<path d="m16 16 4.5 4.5" />
			</svg>
			<label class="visually-hidden" for="article-search">Search all writing</label>
			<input id="article-search" type="search" autocomplete="off" placeholder="Try a title or topic" aria-describedby="search-help search-status" />
			<span class="search-shortcut" aria-hidden="true"><kbd>⌘</kbd><kbd>K</kbd></span>
		</div>
		<p id="search-help" class="search-help">Press <kbd>/</kbd> or <kbd>⌘ K</kbd> to focus search.</p>
		<p id="search-status" class="visually-hidden" role="status" aria-live="polite">
			{posts.length ? `Showing all ${posts.length} ${posts.length === 1 ? 'essay' : 'essays'}.` : 'No essays are published yet.'}
		</p>
		<ul id="search-results" class="search-results" aria-label="Writing archive">
			{posts.map((post) => {
				const published = new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' }).format(post.data.publishedAt);
				const firstTag = post.data.tags[0] ?? 'Writing';
				return (
					<li>
						<a
							class="search-result-card"
							href={'/blog/' + post.id + '/'}
							data-title={post.data.title}
							data-description={post.data.description}
							data-search={[post.data.title, post.data.description, ...post.data.tags].join(' ').toLocaleLowerCase()}
						>
							<span class="article-label"><b>{firstTag}</b><time datetime={post.data.publishedAt.toISOString()}>{published}</time><span aria-hidden="true">·</span><span>{getReadingTime(post.body ?? '')} min read</span></span>
							<strong class="search-result-title">{post.data.title}</strong>
							<span class="search-result-description">{post.data.description}</span>
						</a>
						</li>
					);
			})}
		</ul>
		<p id="search-empty" class="empty-page-print" hidden>
			<b>No matching essays</b><span>Try another word or browse all writing.</span>
			<a class="more-link" href="/blog/">Browse writing</a>
		</p>
		{posts.length === 0 && (
			<div class="empty-page-print search-no-content">
				<p class="exhibit-label"><b>Exhibit 00</b><span>The archive is ready for its first essay</span></p>
				<p>When writing is published, it will be searchable here.</p>
			</div>
		)}
	</section>
	<script is:inline src="/scripts/search.js"></script>
</SiteLayout>
