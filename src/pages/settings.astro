---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHeader from "../components/PageHeader.astro";
export const prerender = false;
---

<SiteLayout title="Account settings" description="Manage your Vyas community profile, preferences, sessions, and account." noindex>
  <section class="page-shell settings-shell" data-settings>
    <PageHeader label="Your account" title="Settings" intro="Manage your public profile and account security." />
    <p class="community-status" data-settings-status>Loading account…</p>
    <section class="settings-card settings-section">
      <h2>Public profile</h2>
      <form data-profile-form class="settings-section">
        <label for="settings-email">Verified account email</label>
        <input id="settings-email" name="email" type="email" readonly />
        <label for="settings-display-name">Display name</label>
        <input id="settings-display-name" name="displayName" maxlength="80" required />
        <label for="settings-username">Username</label>
        <input id="settings-username" name="username" pattern="[a-z0-9_]{3,24}" minlength="3" maxlength="24" required aria-describedby="username-help" />
        <small id="username-help">3–24 lowercase letters, numbers, or underscores. Usernames can be changed once every 30 days.</small>
        <label for="settings-bio">Bio</label>
        <textarea id="settings-bio" name="bio" maxlength="280" rows="3"></textarea>
        <label for="settings-website">Website (HTTPS)</label>
        <input id="settings-website" name="website" type="url" maxlength="2048" />
        <p class="form-message" data-profile-message role="status"></p>
        <button class="pill pill-solid" type="submit">Save profile</button>
      </form>
      <p><a data-profile-link href="/u/">View your public profile</a></p>
    </section>
    <section class="settings-card settings-section">
      <h2>Password and sessions</h2>
      <p data-passwordless-notice hidden>You joined with Google. You can <a href="/forgot-password/">set a password using an email verification code</a>, or keep signing in with Google.</p>
      <form data-password-form class="settings-section">
        <label for="current-password">Current password</label>
        <input id="current-password" name="currentPassword" type="password" autocomplete="current-password" required />
        <label for="new-password">New password</label>
        <input id="new-password" name="newPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required />
        <p class="form-message" data-password-message role="status"></p>
        <button class="pill pill-glass" type="submit">Change password</button>
      </form>
      <button class="text-button" type="button" data-logout>Sign out of this session</button>
      <div class="settings-session-list">
        <h3>Other active sessions</h3>
        <p class="community-status" data-sessions-status>Loading sessions…</p>
        <ul data-session-list></ul>
        <button class="text-button" type="button" data-revoke-other-sessions hidden>Sign out of all other sessions</button>
      </div>
      <p><a href="/notifications/">View notifications</a> <span data-moderation-link hidden>· <a href="/moderation/">Moderation</a></span></p>
    </section>
    <section class="settings-card settings-section">
      <h2>Notifications</h2>
      <form data-preferences-form class="settings-section">
        <label class="settings-inline"><input type="checkbox" name="inAppReplies" /> In-app replies</label>
        <label class="settings-inline"><input type="checkbox" name="emailReplies" /> Email replies (optional)</label>
        <label class="settings-inline"><input type="checkbox" name="moderationUpdates" /> In-app moderation updates</label>
        <label class="settings-inline"><input type="checkbox" name="emailModeration" /> Email moderation updates (optional)</label>
        <small data-email-notice>Email notices require the site's transactional email service. Account verification and password resets use Neon Auth.</small>
        <p class="form-message" data-preferences-message role="status"></p>
        <button class="pill pill-glass" type="submit">Save preferences</button>
      </form>
    </section>
    <section class="settings-card settings-section danger-zone">
      <h2>Delete account</h2>
      <p class="community-status">This permanently deletes your sign-in account, removes your profile and community posts, and ends all sessions. This cannot be undone.</p>
      <form data-delete-form class="settings-section">
        <p data-google-delete-notice hidden>For security, sign in with Google again within five minutes before deleting your account.</p>
        <label data-delete-password-label for="delete-password">Confirm with your password</label>
        <input id="delete-password" name="password" type="password" autocomplete="current-password" required />
        <p class="form-message" data-delete-message role="status"></p>
        <button class="pill pill-glass" type="submit">Delete my account</button>
      </form>
    </section>
  </section>
  <script src="../scripts/settings.ts"></script>
</SiteLayout>
