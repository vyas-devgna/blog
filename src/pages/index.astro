---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getPublishedPosts, getTopics } from '../lib/posts';
import { topicSlug } from '../lib/topics';

export const prerender = true;
const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 4);
const topics = getTopics(allPosts);
const homeSeed = [...'Notes on systems, software and research.'].reduce(
	(seed, letter) => (seed * 31 + letter.charCodeAt(0)) % 2147483647,
	7,
);
const homeStructuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'Blog',
		'@id': 'https://blog.vyasdevgna.online/#blog',
		name: 'Vyas',
		url: 'https://blog.vyasdevgna.online/',
		description: 'Independent notes on software, research, and the things worth understanding.',
		author: {
			'@type': 'Person',
			name: 'Devgna Vyas',
			url: 'https://vyasdevgna.online/',
			image: 'https://blog.vyasdevgna.online/vd-logo.png',
		},
	},
];
---

<SiteLayout
	title="Notes on software and systems"
	description="Independent notes on software, research, and the things worth understanding."
	jsonLd={homeStructuredData}
>
	<section class="home-hero" aria-labelledby="home-title">
		<svg class="hero-art" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
			<defs>
				<filter id="hero-paint" x="-10%" y="-10%" width="120%" height="120%">
					<feTurbulence
						type="fractalNoise"
						baseFrequency=".006 .012"
						numOctaves="3"
						seed={homeSeed}
						result="texture"
					/>
					<feDisplacementMap in="SourceGraphic" in2="texture" scale="58" />
					<feGaussianBlur stdDeviation="30" />
				</filter>
				<radialGradient id="hero-veil">
					<stop offset="0" stop-color="#fbfbfd" stop-opacity=".62" />
					<stop offset=".72" stop-color="#fbfbfd" stop-opacity=".8" />
					<stop offset="1" stop-color="#fbfbfd" stop-opacity=".96" />
				</radialGradient>
			</defs>
			<rect width="1200" height="800" fill="#f5f5f7" />
			<g filter="url(#hero-paint)" opacity=".7">
				<ellipse cx="205" cy="160" rx="310" ry="270" fill="#2a3f9e" />
				<ellipse cx="930" cy="550" rx="355" ry="240" fill="#e24a2c" />
				<ellipse cx="770" cy="120" rx="280" ry="180" fill="#e7a73f" />
				<ellipse cx="360" cy="650" rx="340" ry="210" fill="#8fa58a" />
			</g>
			<rect width="1200" height="800" fill="url(#hero-veil)" />
		</svg>
		<div class="home-hero-content">
			<p class="exhibit-label"><b>Field notes</b><span>Writing by Devgna Vyas</span></p>
			<h1 id="home-title"><span>Notes on systems,</span><em>software &amp; research.</em></h1>
			<p class="hero-copy">
				A place to follow an idea from its first question to the details that make it work.
			</p>
			<div class="hero-actions">
				<a class="pill pill-solid" href="/blog/">Explore the writing</a>
				<a class="pill pill-glass" href="/about/">About this place</a>
				<a class="pill pill-glass" href="/signup/">Join the community</a>
			</div>
		</div>
	</section>

	<section class="home-section" aria-labelledby="recent-heading">
		<div class="section-heading">
			<div>
				<p class="section-label">The archive</p>
				<h2 id="recent-heading">Recent writing</h2>
			</div>
			<a class="more-link" href="/blog/">All writing</a>
		</div>
		{posts.length ? (
			<div class="home-writing-grid">
				{posts.map((post, index) => (
					<div class={index === 0 ? 'home-featured' : 'home-secondary'}>
						<ArticleCard post={post} />
					</div>
				))}
			</div>
		) : (
			<div class="empty-writing">
				<div class="empty-print">
					<svg class="empty-painting" viewBox="0 0 1200 380" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
						<defs>
							<linearGradient id="empty-ground" x1="0" y1="0" x2="1" y2="1">
								<stop offset="0" stop-color="#e9e7ef" />
								<stop offset=".48" stop-color="#d9dce7" />
								<stop offset="1" stop-color="#eee5d8" />
							</linearGradient>
							<radialGradient id="empty-light">
								<stop offset="0" stop-color="#fffdf8" stop-opacity=".94" />
								<stop offset="1" stop-color="#fffdf8" stop-opacity="0" />
							</radialGradient>
						</defs>
						<rect width="1200" height="380" fill="url(#empty-ground)" />
						<path d="M0 290C190 175 320 345 505 215S830 82 1200 224V380H0Z" fill="#2a3f9e" opacity=".34" />
						<path d="M0 320C240 205 410 344 650 246s340-52 550 18v116H0Z" fill="#8fa58a" opacity=".38" />
						<ellipse cx="880" cy="88" rx="340" ry="210" fill="#e7a73f" opacity=".5" />
						<ellipse cx="280" cy="60" rx="280" ry="180" fill="#e24a2c" opacity=".28" />
						<rect width="1200" height="380" fill="url(#empty-light)" />
					</svg>
					<div class="empty-caption">
						<p class="exhibit-label"><b>Exhibit 00</b><span>The first essays are being written</span></p>
					</div>
				</div>
				<div class="empty-links">
					<p>Follow new writing through the RSS feed, or learn more about Devgna’s work.</p>
					<a class="more-link" href="/rss.xml">Subscribe to RSS</a>
					<a class="more-link" href="https://vyasdevgna.online/">Visit the portfolio</a>
				</div>
			</div>
		)}
	</section>

	{topics.length > 0 && (
		<section class="topic-strip" aria-labelledby="topics-heading">
			<div class="topic-strip-heading">
				<p class="section-label">Browse by subject</p>
				<h2 id="topics-heading">Topics</h2>
			</div>
			<ul class="topic-list">
				{topics.map((topic) => (
					<li><a class="topic-chip" href={'/topics/' + topicSlug(topic) + '/'}>{topic}</a></li>
				))}
			</ul>
			<a class="more-link" href="/topics/">All topics</a>
		</section>
	)}
</SiteLayout>
