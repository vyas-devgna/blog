---
import { Image } from 'astro:assets';
import logo from '../../../public/vd-logo.png';
import { author } from '../../lib/seo';
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { coverForSlug, coverSrcSet } from '../../lib/cover';
import { getReadingTime, getPublishedPosts } from '../../lib/posts';
import { topicSlug } from '../../lib/topics';
import ArticleExtras from '../../components/ArticleExtras.astro';

export const prerender = true;

export async function getStaticPaths() {
	return (await getPublishedPosts()).map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const canonical = post.data.canonical ?? new URL('/blog/' + post.id + '/', Astro.site).toString();
const posts = await getPublishedPosts();
const postIndex = posts.findIndex((entry) => entry.id === post.id);
const previousPost = posts[postIndex + 1];
const nextPost = posts[postIndex - 1];
const readingTime = getReadingTime(post.body ?? '');
const cover = post.data.cover ?? coverForSlug(post.id);
const articleNumber = String(postIndex + 1).padStart(2, '0');
const firstTag = post.data.tags[0] ?? 'Writing';
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const published = new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' }).format(
	post.data.publishedAt,
);
const modified = post.data.updatedAt ?? post.data.publishedAt;
const updated = new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' }).format(
	modified,
);
const ogPath = '/og/' + post.id + '.jpg';
const ogImage = new URL(ogPath, Astro.site).toString();
const articleStructuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		headline: post.data.title,
		description: post.data.description,
		datePublished: post.data.publishedAt.toISOString(),
		dateModified: modified.toISOString(),
		author,
		image: [ogImage],
		mainEntityOfPage: canonical,
		publisher: {
			'@type': 'Person',
			name: 'Devgna Vyas',
			url: 'https://vyasdevgna.online/',
		},
		keywords: post.data.tags,
		articleSection: firstTag,
		inLanguage: 'en',
		isAccessibleForFree: true,
		wordCount: (post.body ?? '').split(/\s+/).filter(Boolean).length,
		timeRequired: 'PT' + readingTime + 'M',
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://blog.vyasdevgna.online/' },
			{ '@type': 'ListItem', position: 2, name: 'Writing', item: 'https://blog.vyasdevgna.online/blog/' },
			{ '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
		],
	},
];
---

<SiteLayout
	title={post.data.title}
	description={post.data.description}
	canonical={canonical}
	ogType="article"
	ogImage={ogPath}
	publishedTime={post.data.publishedAt}
	modifiedTime={modified}
	jsonLd={articleStructuredData}
>
	<div class="reading-progress" aria-hidden="true"><span></span></div>
	<div class="article-shell">
		{tocHeadings.length > 0 && (
			<aside class="toc-rail">
				<nav aria-label="On this page">
					<p>On this page</p>
					<ul>
						{tocHeadings.map((heading) => (
							<li class:list={{ 'toc-subheading': heading.depth === 3 }}>
								<a href={'#' + heading.slug}>{heading.text}</a>
							</li>
						))}
					</ul>
				</nav>
			</aside>
		)}
		<article class="article">
			<header class="article-header">
				<p class="article-label">
					<b>No. {articleNumber}</b>
					<time datetime={post.data.publishedAt.toISOString()}>{published}</time>
					<span aria-hidden="true">·</span>
					<span>{readingTime} min read</span>
				</p>
				<h1>{post.data.title}</h1>
				<p class="article-intro">{post.data.description}</p>
				<div class="article-byline">
					<Image src={logo} alt="" width={72} height={72} format="webp" style="width:36px;height:36px" />
					<p>By <a href="https://vyasdevgna.online/">Devgna Vyas</a></p>
				</div>
				<figure class="article-cover">
					<div class="cover-mat">
						<img src={cover} srcset={coverSrcSet(cover)} sizes="(max-width: 760px) calc(100vw - 48px), 760px" alt={post.data.coverAlt ?? ""} width="1200" height="760" fetchpriority="high" />
					</div>
					<figcaption><span>Original AI-generated cover artwork</span><span>{firstTag}</span></figcaption>
				</figure>
			</header>

			{tocHeadings.length > 0 && (
				<details class="toc-mobile">
					<summary>On this page</summary>
					<nav aria-label="Article contents">
						<ul>
							{tocHeadings.map((heading) => (
								<li class:list={{ 'toc-subheading': heading.depth === 3 }}>
									<a href={'#' + heading.slug}>{heading.text}</a>
								</li>
							))}
						</ul>
					</nav>
				</details>
			)}

			<div class="article-body"><Content /></div>

			<section class="community-panel article-comments" id="comments" data-comments data-post-slug={post.id} aria-labelledby="comments-heading">
				<div class="section-heading">
					<div><p class="section-label">Conversation</p><h2 id="comments-heading">Comments</h2></div>
					<a class="more-link" href="/discussions/">Visit discussions</a>
				</div>
				<p class="community-status" data-community-status>Comments load separately so the article stays readable if community services are offline.</p>
				<div class="community-list" data-comment-list aria-live="polite"></div>
				<button class="community-more" type="button" data-comments-more hidden>Load older comments</button>
				<div class="community-auth-prompt" data-community-prompt><a href="/login/">Sign in</a> or <a href="/signup/">create an account</a> to join the conversation.</div>
				<form method="post" class="community-form" data-comment-form hidden>
					<label for="article-comment">Add a comment</label>
					<textarea id="article-comment" name="body" maxlength="3000" rows="4" required></textarea>
					<input type="hidden" name="parentId" />
					<button class="text-button" type="button" data-cancel-reply hidden>Cancel reply</button>
					<div class="challenge-slot" data-challenge-slot hidden></div>
					<p class="form-message" data-form-message role="status"></p>
					<button class="pill pill-solid" type="submit">Post comment</button>
				</form>
			</section>

			<footer class="article-footer">
				<div class="article-footer-heading">
					<p class="section-label">Filed under</p>
					<ul class="card-tags" aria-label="Topics">
						{post.data.tags.map((tag) => (
							<li><a class="topic-chip" href={'/topics/' + topicSlug(tag) + '/'}>{tag}</a></li>
						))}
					</ul>
				</div>
				<div class="article-utilities">
					<a href="#comments">Discuss</a>
					<a href="/rss.xml">RSS feed</a>
					<a href="https://vyasdevgna.online/">More from Devgna Vyas ↗</a>
				</div>
				<small>Updated {updated}</small>
			</footer>

			<ArticleExtras post={post} posts={posts} url={canonical} />

			{(previousPost || nextPost) && (
				<nav class="post-navigation" aria-label="More writing">
					{previousPost && (
						<a href={'/blog/' + previousPost.id + '/'} class="post-nav-tile">
							<span>Previous essay</span>
							<strong>{previousPost.data.title}</strong>
						</a>
					)}
					{nextPost && (
						<a href={'/blog/' + nextPost.id + '/'} class="post-nav-tile post-nav-next">
							<span>Next essay</span>
							<strong>{nextPost.data.title}</strong>
						</a>
					)}
				</nav>
			)}
		</article>
	</div>

	<script is:inline defer src="/scripts/article.js"></script>
	<script src="../../scripts/community.ts"></script>
</SiteLayout>
