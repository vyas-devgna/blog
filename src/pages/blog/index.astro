---
import ArticleCard from '../../components/ArticleCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPublishedPosts } from '../../lib/posts';

export const prerender = true;
const posts = await getPublishedPosts();
---

<SiteLayout title="Writing" description="Essays and field notes on software, research, and systems.">
	<section class="page-shell">
		<PageHeader
			label="The archive"
			title="Writing"
			intro="Essays and field notes on software, research, and systems."
		/>
		{posts.length ? (
			<div class="article-list">{posts.map((post) => <ArticleCard post={post} />)}</div>
		) : (
			<div class="empty-page-print">
				<p class="exhibit-label"><b>Exhibit 00</b><span>The first essays are being written</span></p>
				<p>The archive is quiet for now. Follow the RSS feed or explore more of Devgna’s work.</p>
				<a class="more-link" href="/rss.xml">Subscribe to RSS</a>
				<a class="more-link" href="https://vyasdevgna.online/">Visit the portfolio</a>
			</div>
		)}
	</section>
</SiteLayout>
