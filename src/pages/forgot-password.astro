---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHeader from "../components/PageHeader.astro";
export const prerender = false;
---

<SiteLayout title="Reset your password" description="Request a password reset code for your Vyas account." noindex>
  <section class="page-shell auth-shell">
    <PageHeader label="Your account" title="Reset password" intro="We’ll email a one-time code if the address belongs to an account." />
    <form class="auth-form" data-auth-form data-auth-mode="forgot">
      <label for="reset-email">Email</label>
      <input id="reset-email" name="email" type="email" autocomplete="email" maxlength="320" required />
      <div class="reset-fields" data-reset-fields hidden>
        <label for="reset-code">Email code</label>
        <input id="reset-code" name="otp" inputmode="numeric" autocomplete="one-time-code" minlength="6" maxlength="12" />
        <label for="reset-password">New password</label>
        <input id="reset-password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" />
      </div>
      <p class="form-message" data-form-message role="status"></p>
      <button class="pill pill-solid" type="submit" data-reset-submit>Send reset code</button>
      <p><a href="/login/">Back to sign in</a></p>
    </form>
  </section>
  <script src="../scripts/auth.ts"></script>
</SiteLayout>
