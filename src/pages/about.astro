---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
export const prerender = true;
---

<SiteLayout title="About" description="About this independent publication by Vyas.">
	<section class="page-shell">
		<PageHeader label="The person behind the notes" title="About" />
		<div class="plain-copy"><p>This is an independent publication by Vyas: a place to share writing on software, research, and the details that are easy to miss when building things.</p><p>The site is designed so articles remain open to everyone. Community features are being built separately and will require an account when available.</p></div>
		<a class="more-link" href="https://vyasdevgna.online/">More about Devgna Vyas</a>
	</section>
</SiteLayout>
