---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { author } from '../lib/seo';
export const prerender = true;
const structuredData = [{ '@context': 'https://schema.org', '@type': 'ProfilePage', url: 'https://blog.vyasdevgna.online/about/', mainEntity: author }];
---

<SiteLayout title="About Devgna Vyas" description="Devgna Vyas, also listed as Vyas Devgna, is a systems engineer and published researcher. Read his essays on software, AI agent security, networking, and open source." jsonLd={structuredData}>
	<section class="page-shell">
		<PageHeader label="The person behind the notes" title="Devgna Vyas" />
		<div class="plain-copy"><p>I’m Devgna Vyas, also listed as Vyas Devgna. I’m a systems engineer and published researcher working on agent infrastructure, local-first software, networking, security, and open source. Vyas is my independent publication: a place to share writing on software, research, and the details that are easy to miss when building things.</p><p>I co-authored <a href="https://doi.org/10.1007/978-3-032-22062-2_24">HERMES, a Springer CCIS chapter on network intrusion detection on ARM clusters</a>. My <a href="/blog/edge-intrusion-detection-power-budget/">HERMES article</a> explains the reported results and their limitations. You can find my projects on <a href="https://github.com/vyas-devgna">GitHub</a> and my professional profile on <a href="https://linkedin.com/in/devgna-vyas">LinkedIn</a>.</p><p>The site is designed so articles remain open to everyone. Join with Google or a verified email to comment and take part in community discussions. Your account is separate from the writing, so the articles remain readable without signing in.</p></div>
		<a class="more-link" href="https://vyasdevgna.online/">More about Devgna Vyas</a>
	</section>
</SiteLayout>
