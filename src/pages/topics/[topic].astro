---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { topicSlug } from '../../lib/topics';

export const prerender = true;
export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	const topics = [...new Set(posts.flatMap(({ data }) => data.tags))];
	return topics.map((topic) => ({ params: { topic: topicSlug(topic) }, props: { topic, posts: posts.filter(({ data }) => data.tags.includes(topic)) } }));
}
const { topic, posts } = Astro.props;
---

<SiteLayout title={`Topic: ${topic}`} description={`Articles filed under ${topic}.`}>
	<section class="page-shell">
		<header class="page-heading"><p class="eyebrow">Topic</p><h1 class="page-title">{topic}</h1></header>
		<div class="article-list">{posts.map((post) => <ArticleCard post={post} />)}</div>
	</section>
</SiteLayout>
