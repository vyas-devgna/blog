---
import PageHeader from '../../components/PageHeader.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const projects = [
	{
		name: 'LIWM',
		description: 'Auditable, provenance-gated intent and memory infrastructure for coding agents.',
		href: 'https://github.com/vyas-devgna/liwm-agent-framework',
	},
	{
		name: 'Braids',
		description: 'Engineering rigor for coding agents: evidence, fallbacks, failure paths and verification.',
		href: 'https://github.com/vyas-devgna/braids',
	},
	{
		name: 'EzBoard',
		description: 'Private collaborative canvas for people and AI agents.',
		href: 'https://github.com/vyas-devgna/ezboard',
	},
	{
		name: 'ez-drop',
		description: 'Browser-to-browser file and text transfer.',
		href: 'https://github.com/vyas-devgna/ez-drop',
	},
	{
		name: 'Same.Energy',
		description: 'A native-feeling semantic image-search client.',
		href: 'https://github.com/vyas-devgna/same-energy-android',
	},
	{
		name: 'BeatBlocks',
		description: 'Minecraft-side music control through a local Spicetify bridge.',
		href: 'https://github.com/vyas-devgna/beatblocks-control',
	},
];
export const prerender = true;
---

<SiteLayout title="Projects" description="Selected projects and experiments by Vyas.">
	<section class="page-shell">
		<PageHeader label="Selected work" title="Projects" intro="A growing index of tools, experiments, and open work." />
		<div class="project-grid">
			{projects.map((project) => (
				<a class="project-tile" href={project.href} target="_blank" rel="noreferrer">
					<span class="project-link-label">GitHub project <span aria-hidden="true">↗</span></span>
					<h2>{project.name}</h2>
					<p>{project.description}</p>
				</a>
			))}
		</div>
	</section>
</SiteLayout>
