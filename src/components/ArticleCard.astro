---
import type { CollectionEntry } from 'astro:content';
import { coverForSlug, coverSrcSet } from '../lib/cover';
import { getReadingTime } from '../lib/posts';
import { topicSlug } from '../lib/topics';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const cover = post.data.cover ?? coverForSlug(post.id);
const readingTime = getReadingTime(post.body ?? '');
const firstTag = post.data.tags[0] ?? 'Writing';
const published = new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' }).format(
	post.data.publishedAt,
);
---

<article class="article-card">
	<a class="article-card-link" href={'/blog/' + post.id + '/'}>
		<div class="card-cover">
			<img src={cover} srcset={coverSrcSet(cover)} sizes="(max-width: 700px) calc(100vw - 48px), (max-width: 1100px) 45vw, 400px" alt="" width="1200" height="760" loading="lazy" decoding="async" />
		</div>
		<div class="card-copy">
			<p class="article-label">
				<b>{firstTag}</b>
				<time datetime={post.data.publishedAt.toISOString()}>{published}</time>
				<span aria-hidden="true">·</span>
				<span>{readingTime} min read</span>
			</p>
			<h2>{post.data.title}</h2>
			<p class="card-description">{post.data.description}</p>
			<span class="card-more" aria-hidden="true">Read article <span>↗</span></span>
		</div>
	</a>
	{post.data.tags.length > 0 && (
		<ul class="card-tags" aria-label="Topics">
			{post.data.tags.map((tag) => (
				<li><a class="topic-chip" href={'/topics/' + topicSlug(tag) + '/'}>{tag}</a></li>
			))}
		</ul>
	)}
</article>
