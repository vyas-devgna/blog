---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	canonical?: string;
	noindex?: boolean;
	ogType?: 'website' | 'article';
	ogImage?: string;
	publishedTime?: Date;
	modifiedTime?: Date;
	jsonLd?: Record<string, unknown>[];
}

const {
	title,
	description,
	canonical,
	noindex = false,
	ogType = 'website',
	ogImage = '/og.png',
	publishedTime,
	modifiedTime,
	jsonLd = [],
} = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const serializedJsonLd = jsonLd.map((entry) => JSON.stringify(entry).replace(/</g, '\\u003c'));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#fbfbfd" id="theme-color" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · Vyas</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Vyas" />
		<meta property="og:title" content={title + ' · Vyas'} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Vyas — independent writing by Devgna Vyas" />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
		<meta name="twitter:title" content={title + ' · Vyas'} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="Vyas — independent writing by Devgna Vyas" />
		<link rel="alternate" type="application/rss+xml" title="Vyas · RSS" href="/rss.xml" />
		<link rel="icon" type="image/png" href="/vd-logo.png" />
		<link rel="apple-touch-icon" href="/vd-logo.png" />
		{serializedJsonLd.map((json) => <script type="application/ld+json" set:html={json} />)}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:opsz,wght@14..32,300..700&family=Newsreader:opsz,wght@6..72,300..700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline src="/scripts/theme-init.js"></script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<div class="site-header-inner">
				<a class="wordmark" href="/" aria-label="Vyas home">
					<img src="/vd-logo.png" alt="" width="40" height="40" fetchpriority="high" />
					<span>Vyas</span>
				</a>
				<nav class="desktop-nav" aria-label="Main navigation">
					<a href="/blog/">Writing</a>
					<a href="/topics/">Topics</a>
					<a href="/projects/">Projects</a>
					<a href="/about/">About</a>
					<a href="/search/">Search</a>
					<a href="/discussions/">Community (soon)</a>
				</nav>
				<div class="nav-actions">
					<button
						class="theme-toggle"
						id="theme-toggle"
						type="button"
						aria-label="Toggle color theme"
						aria-pressed="false"
						title="Toggle light and dark appearance"
					>
						<svg class="theme-icon theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="12" cy="12" r="4" />
							<path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
						</svg>
						<svg class="theme-icon theme-icon-moon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z" />
						</svg>
					</button>
					<a class="portfolio-link" href="https://vyasdevgna.online/">Portfolio <span aria-hidden="true">↗</span></a>
					<button
						class="menu-toggle"
						id="menu-toggle"
						type="button"
						aria-label="Open navigation menu"
						aria-controls="mobile-navigation"
						aria-expanded="false"
					>
						<span aria-hidden="true"></span>
						<span aria-hidden="true"></span>
					</button>
				</div>
			</div>
		</header>
		<div
			class="mobile-menu"
			id="mobile-navigation"
			role="dialog"
			aria-modal="true"
			aria-label="Site navigation"
			hidden
		>
			<nav aria-label="Mobile navigation">
				<a href="/blog/">Writing</a>
				<a href="/topics/">Topics</a>
				<a href="/projects/">Projects</a>
				<a href="/about/">About</a>
				<a href="/search/">Search</a>
				<a href="/discussions/">Community (soon)</a>
			</nav>
			<a class="mobile-portfolio" href="https://vyasdevgna.online/">Visit the portfolio ↗</a>
		</div>
		<main id="main"><slot /></main>
		<footer class="site-footer">
			<div class="footer-brand">
				<a class="wordmark" href="/" aria-label="Vyas home">
					<img src="/vd-logo.png" alt="" width="40" height="40" loading="lazy" />
					<span>Vyas</span>
				</a>
				<p>Independent writing on software, research, and the details worth understanding.</p>
			</div>
			<nav class="footer-column" aria-label="Writing">
				<strong>Writing</strong>
				<a href="/blog/">All writing</a>
				<a href="/topics/">Topics</a>
				<a href="/search/">Search</a>
				<a href="/rss.xml">RSS feed</a>
			</nav>
			<nav class="footer-column" aria-label="Elsewhere">
				<strong>Elsewhere</strong>
				<a href="/about/">About Vyas</a>
				<a href="/discussions/">Community (soon)</a>
				<a href="https://vyasdevgna.online/">Portfolio ↗</a>
				<a href="https://github.com/vyas-devgna">GitHub ↗</a>
			</nav>
			<small>© {new Date().getFullYear()} Devgna Vyas. Built for the open web.</small>
		</footer>
		<script is:inline src="/scripts/site.js"></script>
	</body>
</html>
