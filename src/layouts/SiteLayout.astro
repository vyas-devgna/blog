---
import '../styles/global.css';
import '../styles/fonts.css';
import themeInitializer from '../../public/scripts/theme-init.js?raw';
import '../styles/community.css';
import { Image } from 'astro:assets';
import logo from '../../public/vd-logo.png';
import { author, BLOG_NAME, BLOG_URL, serializeJsonLd } from '../lib/seo';
import '../styles/polish.css';

interface Props {
	title: string;
	description: string;
	canonical?: string;
	noindex?: boolean;
	ogType?: 'website' | 'article';
	ogImage?: string;
	publishedTime?: Date;
	modifiedTime?: Date;
	jsonLd?: Record<string, unknown>[];
}

const {
	title,
	description,
	canonical,
	noindex = false,
	ogType = 'website',
	ogImage = '/og.png',
	publishedTime,
	modifiedTime,
	jsonLd = [],
} = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const siteStructuredData = { '@context': 'https://schema.org', '@graph': [author, {
  '@type': 'WebSite', '@id': BLOG_URL + '/#website', url: BLOG_URL + '/', name: BLOG_NAME, alternateName: ['Vyas', 'Vyas Devgna Blog'], inLanguage: 'en', publisher: { '@id': author['@id'] },
}] };
const currentPath = Astro.url.pathname;
const activePage = (href: string) => currentPath.startsWith(href) ? 'page' as const : undefined;
const serializedJsonLd = [siteStructuredData, ...jsonLd].map(serializeJsonLd);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#fbfbfd" id="theme-color" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · {BLOG_NAME}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
		<meta name="author" content="Devgna Vyas" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={BLOG_NAME} />
		<meta property="og:title" content={title + ' · ' + BLOG_NAME} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Vyas — independent writing by Devgna Vyas" />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
		<meta name="twitter:title" content={title + ' · ' + BLOG_NAME} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="Vyas — independent writing by Devgna Vyas" />
		<link rel="alternate" type="application/rss+xml" title="Vyas · RSS" href="/rss.xml" />
		<link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="Vyas" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="application-name" content="Vyas" />
		{serializedJsonLd.map((json) => <script type="application/ld+json" set:html={json} />)}
		<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/instrument-serif-5a51946dff.woff2" />
		<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/inter-2c295d99e2.woff2" />
		<script is:inline set:html={themeInitializer}></script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<div class="site-header-inner">
				<a class="wordmark" href="/" aria-label="Vyas home">
					<Image src={logo} alt="" width={80} height={80} format="webp" class="brand-logo" />
					<span>Vyas</span>
				</a>
				<nav class="desktop-nav" aria-label="Main navigation">
					<a href="/blog/" aria-current={activePage('/blog/')}>Writing</a>
					<a href="/topics/" aria-current={activePage('/topics/')}>Topics</a>
					<a href="/projects/" aria-current={activePage('/projects/')}>Projects</a>
					<a href="/about/" aria-current={activePage('/about/')}>About</a>
					<a href="/search/" aria-current={activePage('/search/')}>Search</a>
					<a href="/discussions/" aria-current={activePage('/discussions/')}>Community</a>
				</nav>
				<div class="nav-actions">
					<a data-anonymous-nav class="account-nav-link" href="/login/">Sign in</a>
					<a data-anonymous-nav class="account-nav-link account-nav-join" href="/signup/">Join</a>
          <details class="account-menu" data-account-menu hidden>
            <summary aria-label="Open account menu" title="Your account"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4" /><path d="M4 22v-3a8 8 0 0 1 16 0v3" /></svg></summary>
            <div class="account-menu-panel">
              <span class="account-avatar" data-account-initials aria-hidden="true">V</span>
              <span data-account-name>Your account</span>
              <a href="/settings/">Profile and settings</a>
              <a href="/notifications/">Notifications</a>
              <a href="/moderation/" data-account-moderation hidden>Moderation</a>
              <button type="button" data-account-logout>Sign out</button>
              <span role="status" data-account-error></span>
            </div>
          </details>
					<button
						class="theme-toggle"
						id="theme-toggle"
						type="button"
						aria-label="Toggle color theme"
						aria-pressed="false"
						title="Toggle light and dark appearance"
					>
						<svg class="theme-icon theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="12" cy="12" r="4" />
							<path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
						</svg>
						<svg class="theme-icon theme-icon-moon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z" />
						</svg>
					</button>
					<a class="portfolio-link" href="https://vyasdevgna.online/">Portfolio <span aria-hidden="true">↗</span></a>
					<button
						class="menu-toggle"
						id="menu-toggle"
						type="button"
						aria-label="Open navigation menu"
						aria-controls="mobile-navigation"
						aria-expanded="false"
					>
						<span aria-hidden="true"></span>
						<span aria-hidden="true"></span>
					</button>
				</div>
			</div>
		</header>
		<div
			class="mobile-menu"
			id="mobile-navigation"
			role="dialog"
			aria-modal="true"
			aria-label="Site navigation"
			hidden
		>
			<nav aria-label="Mobile navigation">
				<a href="/blog/" aria-current={activePage('/blog/')}>Writing</a>
				<a href="/topics/" aria-current={activePage('/topics/')}>Topics</a>
				<a href="/projects/" aria-current={activePage('/projects/')}>Projects</a>
				<a href="/about/" aria-current={activePage('/about/')}>About</a>
				<a href="/search/" aria-current={activePage('/search/')}>Search</a>
				<a href="/discussions/" aria-current={activePage('/discussions/')}>Community</a>
				<a data-anonymous-nav href="/login/">Sign in</a>
				<a data-anonymous-nav href="/signup/">Create an account</a>
        <a data-authenticated-nav href="/settings/" hidden>My account</a>
			</nav>
			<a class="mobile-portfolio" href="https://vyasdevgna.online/">Visit the portfolio ↗</a>
		</div>
		<main id="main"><slot /></main>
		<footer class="site-footer">
			<div class="footer-brand">
				<a class="wordmark" href="/" aria-label="Vyas home">
					<Image src={logo} alt="" width={80} height={80} format="webp" class="brand-logo" loading="lazy" />
					<span>Vyas</span>
				</a>
				<p>Independent writing on software, research, and the details worth understanding.</p>
			</div>
			<nav class="footer-column" aria-label="Writing">
				<strong>Writing</strong>
				<a href="/blog/" aria-current={activePage('/blog/')}>All writing</a>
				<a href="/topics/" aria-current={activePage('/topics/')}>Topics</a>
				<a href="/search/" aria-current={activePage('/search/')}>Search</a>
				<a href="/rss.xml">RSS feed</a>
			</nav>
			<nav class="footer-column" aria-label="Elsewhere">
				<strong>Elsewhere</strong>
				<a href="/about/" aria-current={activePage('/about/')}>About Vyas</a>
				<a href="/discussions/" aria-current={activePage('/discussions/')}>Community</a>
				<a href="https://vyasdevgna.online/">Portfolio ↗</a>
				<a href="https://github.com/vyas-devgna">GitHub ↗</a>
			</nav>
			<small>© {new Date().getFullYear()} Devgna Vyas. Built for the open web.</small>
		</footer>
		<script is:inline defer src="/scripts/site.js"></script>
		<script is:inline src="/scripts/polish.js" defer></script>
		<script is:inline src="/scripts/pwa.js" defer></script>
    <script src="../scripts/account-nav.ts"></script>
	</body>
</html>
